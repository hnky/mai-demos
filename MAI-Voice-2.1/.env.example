# Use the KEY AND REGION OF THE SAME voice-enabled Azure resource.
# Separate names prevent accidental reuse of a transcription resource's key.
VOICE_SPEECH_REGION=
VOICE_SPEECH_KEY=

# Only needed for Demo 6. Use the resource's HTTPS custom-subdomain root,
# for example https://your-voice-resource.cognitiveservices.azure.com
VOICE_SPEECH_ENDPOINT=
